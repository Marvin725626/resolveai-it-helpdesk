APP_NAME=ResolveAI
APP_ENV=development
AUTH_SECRET=replace-with-a-random-local-secret
DATABASE_URL=sqlite+aiosqlite:///./resolveai.db
DEFAULT_LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
IT_EMBEDDING_PROVIDER=local
IT_EMBEDDING_DIMENSION=256
IT_DEMO_ENABLED=true
IT_DEMO_PASSWORD=replace-with-a-random-local-password
IT_MAX_RETRIEVAL_ATTEMPTS=2
IT_EVIDENCE_THRESHOLD=0.12
