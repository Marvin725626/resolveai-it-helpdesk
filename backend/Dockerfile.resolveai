FROM python:3.12-slim AS build
WORKDIR /build
COPY backend/requirements.lock.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements.lock.txt

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 APP_SCHEMA_MODE=migrate
WORKDIR /app/backend
COPY --from=build /install /usr/local
RUN groupadd --gid 10001 resolveai && useradd --uid 10001 --gid resolveai --no-create-home resolveai \
    && mkdir -p /var/lib/resolveai/attachments /app/docs \
    && chown -R resolveai:resolveai /var/lib/resolveai
COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY backend/app ./app
COPY backend/data ./data
COPY docs/evaluation.offline.json /app/docs/evaluation.offline.json
COPY scripts/postgres_smoke.py scripts/verify_deployment_fixture.py /app/scripts/
USER resolveai
EXPOSE 8000
CMD ["sh", "-c", "python -m alembic upgrade head && exec python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]
