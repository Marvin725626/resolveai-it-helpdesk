# Node.js / Frontend
node_modules/
frontend/node_modules/
frontend_old_backup/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs
dist/
frontend/dist/
.next/
out/
.docusaurus/

