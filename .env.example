# ==============================================================================
# AI SupportPro — Environment Configuration Template
# ==============================================================================
# IMPORTANT: This is a template file. Never commit real credentials to version control.
# Copy this file to .env for local development with your actual keys.

# Application Configuration
APP_NAME="AI SupportPro"
APP_ENV=development
APP_PORT=8000
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication & Security
# Generate a strong 32+ character key using: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-string-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Production: postgresql+asyncpg://user:password@localhost:5432/ai_supportpro
# Local Standalone Development / Testing fallback:
DATABASE_URL="sqlite+aiosqlite:///./ai_supportpro.db"
DATABASE_ECHO=False

# Redis & Background Queue (Optional for local standalone; required in Docker/prod)
REDIS_URL="redis://localhost:6379/0"

# AI Provider Configuration
# Supported providers: mock | openai | gemini | anthropic
# "mock" runs a deterministic, zero-cost, high-fidelity offline engine (ideal for testing & offline demos)
DEFAULT_LLM_PROVIDER="mock"

# OpenAI Configuration
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Google Gemini Configuration
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Anthropic Configuration
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-haiku-20240307"

# RAG & Grounding Parameters (Experimentally calibrated threshold)
SIMILARITY_THRESHOLD=0.35
RAG_SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_CHUNKS=4
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Integrations (mock | real)
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
SUPPORT_EMAIL_ADDRESS="support@example.com"

WHATSAPP_PROVIDER="mock"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="your_meta_webhook_verify_token"
WHATSAPP_APP_SECRET="your_meta_app_secret"

# Docker & Production Database Credentials
POSTGRES_USER="supportpro_user"
POSTGRES_PASSWORD="generate_a_secure_postgres_password_here"
POSTGRES_DB="ai_supportpro"

# Cost & Rate Limiting Guardrails
MAX_DAILY_TOKENS_PER_TENANT=1000000
RATE_LIMIT_PER_MINUTE=60
